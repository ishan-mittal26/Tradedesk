  },

  "ai": {
    "model": "claude-sonnet-4-6",
    "max_tokens": 1024,
    "temperature": 0,
    "agents_parallel": ["agent_indicator", "agent_confluence", "agent_options", "agent_news", "agent_chart", "agent_journal"],
    "orchestrator": "agent_orchestrator",
    "prompt_caching": true,
    "fallback_to_tier1_on_api_down": true
